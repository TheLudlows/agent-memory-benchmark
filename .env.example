# Docker Desktop / Linux Docker Engine: reach a test server on the host.
HINDSIGHT_HTTP_URL=http://host.docker.internal:8888
HINDSIGHT_HTTP_KEY=
GEMINI_API_KEY=
OMB_ANSWER_LLM=gemini
OMB_JUDGE_LLM=gemini

# Optionally allow direct Workbench access from a trusted network.
# AMB_WORKBENCH_BIND=0.0.0.0
# AMB_WORKBENCH_ALLOWED_HOSTS=192.0.2.10,amb.example.com
# AMB_WORKBENCH_MAX_CONCURRENT_RUNS=2

# For --memory contextbase, use a pre-authorized test Bank and a read/write business key.
# CONTEXTBASE_API_URL=http://host.docker.internal:8888
# CONTEXTBASE_API_TOKEN=
# CONTEXTBASE_BANK_ID=
# CONTEXTBASE_BENCH_BANKS={"conv-26":"locomo-26","conv-30":"locomo-30"}
# AMB_RECALL_TYPES=world,experience

# For CLI ContextBase Knowledge Retrieval, leave Bank ID empty to create a Bank per run.
# The business key above must have read/write access to new Banks.
# CONTEXTBASE_BENCH_ADMIN_TOKEN=

# Mem0 Cloud (AMB Workbench).
# MEM0_CLOUD_KEY=

# WeKnora (Knowledge Retrieval).
# WEKNORA_API_URL=http://host.docker.internal:8080
# WEKNORA_API_KEY=
# WEKNORA_TENANT_ID=
# WEKNORA_EMBEDDING_MODEL_ID=
# WEKNORA_VLM_MODEL_ID=

# Optional: select and pin the two model IDs for comparisons.
# OMB_ANSWER_MODEL=gemini-2.5-flash-lite
# OMB_JUDGE_MODEL=gemini-2.5-flash-lite
# For an OpenAI-compatible endpoint, set both OMB_*_LLM values to openai
# and add OPENAI_API_KEY, OPENAI_BASE_URL and both model IDs.
